# ─── Required ───────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/citatra
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# SerpApi (required for AI Overview fetching)
# Get your API key at https://serpapi.com/
SERPAPI_API_KEY=your-serpapi-api-key

# ─── Optional: Google Analytics 4 (Traffic Attribution) ─────
# GA4_SERVICE_ACCOUNT_EMAIL=
# GA4_PRIVATE_KEY=

# ─── Optional: Cron Secret ──────────────────────────────────
# CRON_SECRET=your-cron-secret

# ─── Optional: Pusher (Real-time updates, private channels) ──
# 服务端配置（签发频道授权）+ 客户端公开 key（订阅）
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=
